<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- header: one line (34dp, bigger text)
         with rounded bottom corners. "D-SMS" sits in the EXACT center and never
         moves; the chat count is on the left; on the right "All read" or an
         "N new" pill. The side texts get a max width in code so long counts
         never reach the title. Colors come from the accent / theme
         (ThemeUtils.styleMainHeader). The old + and menu icons are kept as
         GONE views only so existing code compiles; they never take focus
         (the soft keys do New / Options). -->
    <FrameLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:elevation="3dp">

        <ImageButton
            android:id="@+id/btnCompose"
            android:focusable="false"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@null"
            android:contentDescription="@string/softkey_compose"
            android:src="@drawable/ic_add" />

        <TextView
            android:id="@+id/chatCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@android:color/white"
            android:alpha="0.8"
            android:textSize="13sp"
            android:focusable="false" />

        <TextView
            android:id="@+id/mainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/allRead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/main_all_read"
            android:textColor="@android:color/white"
            android:alpha="0.8"
            android:textSize="13sp"
            android:focusable="false" />

        <TextView
            android:id="@+id/unreadPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:focusable="false"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:focusable="false"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@null"
            android:contentDescription="@string/menu_settings"
            android:src="@drawable/ic_menu" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/searchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:background="@drawable/bg_search"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="14sp"
            android:importantForAutofill="no" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contentView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="2dp">


            <LinearLayout
                android:id="@+id/mainSelectionBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="6dp"
                android:visibility="gone"
                android:background="?attr/colorSurfaceContainerHigh">

                <Button
                    android:id="@+id/btnSelCancelMain"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@android:string/cancel" />

                <Button
                    android:id="@+id/btnSelDeleteMain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/delete" />
            </LinearLayout>

            <TextView
                android:id="@+id/filterChip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:gravity="center"
                android:padding="8dp"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:focusable="false"
                android:clickable="true"
                android:background="@drawable/filter_chip_bg" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/convoList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                android:clipToPadding="false"
                android:paddingTop="2dp"
                android:paddingBottom="4dp"
                android:descendantFocusability="afterDescendants" />
        </LinearLayout>

        <TextView
            android:id="@+id/emptyLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_conversations"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/gateView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone"
            android:background="?android:attr/colorBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/gate_message"
                android:textSize="15sp" />

            <Button
                android:id="@+id/gateButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/gate_button" />
        </LinearLayout>
    </FrameLayout>

    <include
        android:id="@+id/softkeyBar"
        layout="@layout/view_softkey_bar" />
</LinearLayout>
