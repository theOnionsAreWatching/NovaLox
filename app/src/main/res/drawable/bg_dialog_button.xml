<?xml version="1.0" encoding="utf-8"?>
<!-- Pop-up buttons: accent text; when focused, a filled accent pill. -->
<selector android:enterFadeDuration="90" android:exitFadeDuration="90" xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <inset android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/colorPrimary" />
                <corners android:radius="16dp" />
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/colorPrimary" />
                <corners android:radius="16dp" />
            </shape>
        </inset>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
