<?xml version="1.0" encoding="utf-8"?>
<!-- Settings clean-up. Keys are unchanged so
     backups and settings files stay compatible. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ListPreference
        app:iconSpaceReserved="false"
        android:key="softkey_mode"
        android:title="@string/st_softkey_bar"
        android:entries="@array/softkey_entries"
        android:entryValues="@array/softkey_values"
        android:defaultValue="auto"
        android:summary="%s" />
    <Preference
        app:iconSpaceReserved="false"
        android:key="open_softkeys"
        android:title="@string/st_softkey_setup"
        android:summary="@string/st_softkey_setup_sum" />
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        android:key="send_on_left"
        android:title="@string/pref_send_on_left"
        android:summary="@string/pref_send_on_left_summary"
        android:defaultValue="false" />
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        android:key="softkeys_focusable"
        android:title="@string/st_softkeys_dpad"
        android:summary="@string/st_softkeys_dpad_sum"
        android:defaultValue="false" />
    <Preference
        app:iconSpaceReserved="false"
        android:key="key_guide"
        android:title="@string/key_guide_title"
        android:summary="@string/key_guide_summary" />
    <Preference
        app:iconSpaceReserved="false"
        android:selectable="false"
        android:summary="@string/softkey_trouble_hint" />
    <Preference
        app:iconSpaceReserved="false"
        android:key="hint_softkeys"
        android:layout="@layout/pref_hint"
        android:selectable="false"
        android:persistent="false"
        android:summary="@string/st_hint_keys" />
</PreferenceScreen>
