<?xml version="1.0" encoding="utf-8"?>
<!-- Settings clean-up. Keys are unchanged so
     backups and settings files stay compatible. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ListPreference
        app:iconSpaceReserved="false"
        android:key="mms_client_profile"
        android:title="@string/st_mms_profile"
        android:entries="@array/mms_profile_entries"
        android:entryValues="@array/mms_profile_values"
        android:defaultValue="carrier"
        android:summary="%s" />
    <EditTextPreference
        app:iconSpaceReserved="false"
        android:key="mms_custom_ua"
        android:title="@string/st_custom_ua"
        android:summary="@string/st_custom_ua_sum" />
    <EditTextPreference
        app:iconSpaceReserved="false"
        android:key="mms_custom_uaprof"
        android:title="@string/st_custom_prof"
        android:summary="@string/st_custom_prof_sum" />
</PreferenceScreen>
