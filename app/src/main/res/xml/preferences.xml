<?xml version="1.0" encoding="utf-8"?>
<!-- Settings clean-up. Keys are unchanged so
     backups and settings files stay compatible. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <Preference
        app:iconSpaceReserved="false"
        android:layout="@layout/pref_row_main"
        android:key="open_search"
        android:title="@string/st_search" />
    <Preference
        app:iconSpaceReserved="false"
        android:layout="@layout/pref_row_main"
        android:key="open_notifications"
        android:title="@string/st_notifications" />
    <Preference
        app:iconSpaceReserved="false"
        android:layout="@layout/pref_row_main"
        android:key="open_messages"
        android:title="@string/st_messages" />
    <Preference
        app:iconSpaceReserved="false"
        android:layout="@layout/pref_row_main"
        android:key="open_appearance"
        android:title="@string/st_appearance" />
    <Preference
        app:iconSpaceReserved="false"
        android:layout="@layout/pref_row_main"
        android:key="open_keys"
        android:title="@string/st_keys" />
    <Preference
        app:iconSpaceReserved="false"
        android:layout="@layout/pref_row_main"
        android:key="open_blocked_hidden"
        android:title="@string/st_blocked" />
    <Preference
        app:iconSpaceReserved="false"
        android:layout="@layout/pref_row_main"
        android:key="open_storage"
        android:title="@string/st_storage" />
    <Preference
        app:iconSpaceReserved="false"
        android:layout="@layout/pref_row_main"
        android:key="open_backup"
        android:title="@string/st_backup" />
    <Preference
        app:iconSpaceReserved="false"
        android:layout="@layout/pref_row_main"
        android:key="open_advanced"
        android:title="@string/st_advanced" />
    <Preference
        app:iconSpaceReserved="false"
        android:layout="@layout/pref_row_main"
        android:key="about_footer"
        android:title="@string/about_app_name" />
</PreferenceScreen>
