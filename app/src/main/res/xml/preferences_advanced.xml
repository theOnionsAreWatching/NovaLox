<?xml version="1.0" encoding="utf-8"?>
<!-- Settings clean-up. Keys are unchanged so
     backups and settings files stay compatible. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <Preference
        app:iconSpaceReserved="false"
        android:key="resync"
        android:title="@string/st_resync"
        android:summary="@string/st_resync_sum" />
    <Preference
        app:iconSpaceReserved="false"
        android:key="reimport"
        android:title="@string/st_rebuild"
        android:summary="@string/st_rebuild_sum" />
    <Preference
        app:iconSpaceReserved="false"
        android:key="refresh_contacts"
        android:title="@string/refresh_contacts_pref"
        android:summary="@string/st_refresh_contacts_sum" />
    <Preference
        app:iconSpaceReserved="false"
        android:key="open_carrier"
        android:title="@string/st_carrier"
        android:summary="@string/st_carrier_sum" />
    <ListPreference
        app:iconSpaceReserved="false"
        android:key="voice_format"
        android:title="@string/pref_voice_format"
        android:entries="@array/voice_format_entries"
        android:entryValues="@array/voice_format_values"
        android:defaultValue="m4a"
        android:summary="%s" />
    <Preference
        app:iconSpaceReserved="false"
        android:key="check_updates"
        android:title="@string/pref_check_updates" />
    <SwitchPreferenceCompat
        app:singleLineTitle="false"
        app:iconSpaceReserved="false"
        android:key="delete_apk_after_update"
        android:title="@string/pref_delete_apk"
        android:summary="@string/pref_delete_apk_summary"
        android:defaultValue="true" />
    <Preference
        app:iconSpaceReserved="false"
        android:key="save_diag_log"
        android:title="@string/pref_save_log"
        android:summary="@string/st_save_log_sum" />
</PreferenceScreen>
