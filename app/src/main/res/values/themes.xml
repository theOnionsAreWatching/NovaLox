<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DSMS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:textColorLink">@color/accent_blue</item>
        <item name="alertDialogTheme">@style/DSMS.AlertDialog</item>
        <!-- framework android.app.AlertDialog (attach list, recorder, ...)
             gets the same look; it is applied on top of this activity theme,
             so light/dark and the accent overlay carry over -->
        <item name="android:alertDialogTheme">@style/DSMS.AlertDialog</item>
        <!-- Settings rows: compact, left-aligned, accent focus -->
        <item name="preferenceTheme">@style/DSMS.PreferenceTheme</item>
        <!-- theme colours: Light/Dark defaults (full themes: ThemeFull_*) -->
        <item name="dsmsText">@color/text_primary</item>
        <item name="dsmsSurface">@color/dialog_surface</item>
        <item name="dsmsDivider">@color/divider</item>
        <item name="dsmsBubbleOther">@color/bubble_other</item>
        <item name="dsmsPill">@color/compose_pill</item>
        <item name="dsmsRim">@color/dialog_rim</item>
        <item name="dsmsTextDisabled">@color/dialog_text_disabled</item>
        <item name="dsmsFocusFill">@color/focus_fill</item>
    </style>

    <style name="DSMS.PreferenceTheme" parent="PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/DSMS.Pref</item>
        <item name="switchPreferenceCompatStyle">@style/DSMS.Pref.Switch</item>
        <item name="preferenceCategoryStyle">@style/DSMS.Pref.Category</item>
        <item name="dialogPreferenceStyle">@style/DSMS.Pref.Dialog</item>
        <item name="editTextPreferenceStyle">@style/DSMS.Pref.EditText</item>
    </style>
    <style name="DSMS.Pref" parent="Preference.Material">
        <item name="android:layout">@layout/pref_row</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="DSMS.Pref.Switch" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/pref_row</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="DSMS.Pref.Category" parent="Preference.Category.Material">
        <item name="android:layout">@layout/pref_category</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="DSMS.Pref.Dialog" parent="Preference.DialogPreference.Material">
        <item name="android:layout">@layout/pref_row</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>
    <style name="DSMS.Pref.EditText" parent="Preference.DialogPreference.EditTextPreference.Material">
        <item name="android:layout">@layout/pref_row</item>
        <item name="iconSpaceReserved">false</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <!-- pop-up look: soft rounded card (bg_dialog), accent line
         under the title, accent pill on the focused row / button, short
         fade + scale in. Colors come from values / values-night (theme
         setting) and ?attr/colorPrimary (the accent overlay). -->
    <style name="DSMS.AlertDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowAnimationStyle">@style/DSMS.DialogAnimation</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowTitleStyle">@style/DSMS.DialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/DSMS.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DSMS.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/DSMS.DialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DSMS.DialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DSMS.DialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/DSMS.DialogButton</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/bg_dialog_item</item>
        <item name="listChoiceBackgroundIndicator">@drawable/bg_dialog_item</item>
        <item name="android:textColorAlertDialogListItem">@color/dialog_item_text</item>
        <item name="textColorAlertDialogListItem">@color/dialog_item_text</item>
    </style>

    <style name="DSMS.DialogAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_out</item>
    </style>

    <style name="DSMS.DialogTitle" parent="RtlOverlay.DialogWindowTitle.AppCompat">
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_dialog_title</item>
        <!-- Framework title fallback reserves a full gap + bar below glyphs. -->
        <item name="android:includeFontPadding">true</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="DSMS.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:background">@drawable/bg_dialog_button</item>
        <item name="android:textColor">@color/dialog_button_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>

